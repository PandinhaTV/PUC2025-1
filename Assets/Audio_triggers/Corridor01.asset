  voiceClip: {fileID: 8300000, guid: 93e75687b48a8c84f92ec49a4cfca6db, type: 3}
  lines:
  - text: "Well\u2026 hello there\u2026"
    startTime: 0
    endTime: 2
  - text: "I believe you\u2019re asking yourself\u2026"
    startTime: 3
    endTime: 5
  - text: "Who am I? Or rather\u2026 who are we? Do you know who you are?"
    startTime: 6
    endTime: 11
  - text: "I can feel that you are afraid. I\u2019ll accompany you on this journey."
    startTime: 11
    endTime: 16
  - text: "A voice in my head\u2026?"
    startTime: 17
    endTime: 19
  - text: "Am I finally going insane\u2026?"
    startTime: 19
    endTime: 21
  - text: "Ohohoho\u2026"
    startTime: 22
    endTime: 25
  - text: Think of me as a guide, perhaps even a friend.
    startTime: 25
    endTime: 29
  - text: Where am I? What is this place?
    startTime: 30
    endTime: 33
  - text: " I don\u2019t remember my name..."
    startTime: 33
    endTime: 35
  - text: " I don\u2019t remember my name..."
    startTime: 33
    endTime: 35
