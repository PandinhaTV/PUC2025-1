  m_Script: {fileID: 11500000, guid: bd3a94c0d14ea0146a5cfd133f70b89e, type: 3}
  m_Name: room2 1
  m_EditorClassIdentifier: 
  voiceClip: {fileID: 8300000, guid: 79e0e982ba9a63640ac70244587a31fb, type: 3}
  lines:
  - text: "Stained Mary: You must have heard the news about my expulsion by now\u2026 "
    startTime: 0
    endTime: 6
  - text: " It\u2019s far too late to do anything about it so just finish reading
      what i have to say"
    startTime: 7
    endTime: 12
  - text: "I know you aren\u2019t much of a sentimentalist but..My heart has fallen
      ill.  And it\u2019s been numb for a long time."
    startTime: 13
    endTime: 19
  - text: " I can\u2019t help but miss you already."
    startTime: 20
    endTime: 23
  - text: I was selfish... I tried to keep you at my fingertips without thinking
      about the consequences. How much you would suffer the day they found out.
    startTime: 24
    endTime: 32
  - text: "Since I left, I\u2019ve been keeping my hands in my pockets... hoping
      your warmth wouldn\u2019t fade away. But I had to write to you, I wanted to
      say goodbye."
    startTime: 33
    endTime: 42
