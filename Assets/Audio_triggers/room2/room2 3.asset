  m_Script: {fileID: 11500000, guid: bd3a94c0d14ea0146a5cfd133f70b89e, type: 3}
  m_Name: room2 3
  m_EditorClassIdentifier: 
  voiceClip: {fileID: 8300000, guid: c35deb33efa7ae04f9a0458f027f87ef, type: 3}
  lines:
  - text: " If you\u2019ve taken my heart already,  then take all of me.  Consume
      me completely,  and we can flee this awful place together."
    startTime: 0
    endTime: 8
  - text: "but it\u2019s impossible now."
    startTime: 9
    endTime: 10
  - text: "These emotions spill as ink because they have nowhere else to go. Maybe,
      that\u2019s all they should have ever been.  I have no right to tell them out
      loud."
    startTime: 11
    endTime: 20
  - text: "I know that I am to blame.  I won\u2019t pretend everything is alright
      anymore. I wish it was different. "
    startTime: 21
    endTime: 27
  - text: " So this is it, my goodbye\u2026be happy, and please just\u2026forget
      about me."
    startTime: 26
    endTime: 35
